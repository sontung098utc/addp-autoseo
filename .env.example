APP_NAME="Auto SEO & Publisher"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=autoseo
DB_USERNAME=autoseo_user
DB_PASSWORD=autoseo_secret
DB_ROOT_PASSWORD=root_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=autoseo_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="autoseo@company.local"
MAIL_FROM_NAME="${APP_NAME}"

# Cấu hình AI Provider (Thử nghiệm & Production)
AI_DEFAULT_PROVIDER=google
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Giới hạn & Quota
MAX_ARTICLES_PER_SITE_DAY=5
MAX_IMAGES_PER_ARTICLE=3
AUTO_PUBLISH_ENABLED=true

# Base URL nội bộ được phép cho nhà cung cấp AI (host:cổng, cách nhau dấu phẩy). Mặc định rỗng.
AI_PRIVATE_BASE_URL_ALLOWLIST=

# Đường dẫn PHP CLI cho tiến trình nền chạy bài (để trống = tự dò). Hosting có PHP tên riêng thì đặt rõ, vd. /usr/local/php82/bin/php82
AGENT_PHP_BINARY=

# Tạo ảnh chạy SONG SONG với bước viết bằng tiến trình con (cần CSDL dùng chung được giữa hai tiến trình, không dùng SQLite :memory:).
AGENT_IMAGES_PARALLEL=false
# Tối ưu ảnh AI tạo (WebP): chiều rộng tối đa (px) và chất lượng 1-100.
AGENT_IMAGES_MAX_WIDTH=1200
AGENT_IMAGES_QUALITY=76

# --- Dữ liệu tìm kiếm thật (để trống nếu chưa có; thiếu thì tính năng báo "chưa có dữ liệu", không dùng số giả) ---
# DataForSEO: lượt tìm, câu hỏi liên quan (PAA), top 10 SERP để gom cụm và đề xuất chiến dịch.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Gợi ý tự động của Google (không cần khóa). Đặt false để tắt.
SERP_AUTOCOMPLETE=true
# Search Console thật: đường dẫn tới file JSON service account (để NGOÀI repo), rồi thêm email service account vào từng thuộc tính trong Search Console.
GSC_SERVICE_ACCOUNT_JSON=
# domain => sc-domain:ten-mien.vn ; url => https://ten-mien.vn/ ; ghi đè theo site: GSC_PROPERTIES="a.vn=sc-domain:a.vn;b.vn=https://b.vn/"
GSC_PROPERTY_TYPE=domain
GSC_PROPERTIES=
# Wikimedia yêu cầu User-Agent có cách liên hệ khi gọi API lượt xem bài Wikipedia (xu hướng miễn phí). Điền email hoặc URL của đội.
TRENDS_CONTACT=
